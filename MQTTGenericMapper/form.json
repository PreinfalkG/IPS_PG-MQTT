{
    "elements": [
        {
            "type": "CheckBox",
            "name": "DebugMode",
            "caption": "Debug-Meldungen aktiv (sichtbar im Debug-Panel dieser Instanz)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "1) Topics entdecken (optional, spart Tipparbeit)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Lernmodus einschalten, Änderungen übernehmen, ein paar Sekunden/Minuten warten (bis eure Topics einmal gesendet wurden), Formular neu öffnen. Danach unten gewünschte Topics auswählen und übernehmen."
                },
                {
                    "type": "CheckBox",
                    "name": "DiscoverMode",
                    "caption": "Lernmodus aktiv (alle Topics des Parents mitschneiden)"
                },
                {
                    "type": "List",
                    "name": "DiscoveredList",
                    "caption": "Erkannte Topics",
                    "rowCount": 10,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Topic",
                            "name": "Topic",
                            "width": "420px"
                        },
                        {
                            "caption": "Letzter Payload",
                            "name": "Payload",
                            "width": "220px"
                        },
                        {
                            "caption": "Zuletzt gesehen",
                            "name": "LastSeen",
                            "width": "160px"
                        }
                    ],
                    "values": []
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Ausgewählte Topics übernehmen",
                            "onClick": "MQTTMAP_AddSelectedTopics($id, $DiscoveredList);"
                        },
                        {
                            "type": "Button",
                            "caption": "Alle erkannten Topics übernehmen",
                            "onClick": "MQTTMAP_AddAllDiscoveredTopics($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Liste erkannter Topics leeren",
                            "onClick": "MQTTMAP_ClearDiscovered($id);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Hinweis zu Parser + Typ: Bei 'Datum/Zeit -> Unix-Timestamp' bzw. 'String -> Ganzzahl' zusätzlich den Typ auf 'Integer' stellen. Bei 'Keine (Rohwert)' entscheidet allein der Typ über die einfache Umwandlung (z.B. \"true\"/\"1\" -> Boolean)."
        },
        {
            "type": "List",
            "name": "Mappings",
            "caption": "2) Topic → Variablen Mapping",
            "rowCount": 20,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Aktiv",
                    "name": "Active",
                    "width": "60px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "MQTT Topic",
                    "name": "Topic",
                    "width": "360px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Ident",
                    "name": "Ident",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Typ",
                    "name": "VarType",
                    "width": "110px",
                    "add": 3,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Boolean",
                                "value": 0
                            },
                            {
                                "caption": "Integer",
                                "value": 1
                            },
                            {
                                "caption": "Float",
                                "value": 2
                            },
                            {
                                "caption": "String",
                                "value": 3
                            }
                        ]
                    }
                },
                {
                    "caption": "Parser",
                    "name": "Parser",
                    "width": "180px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Keine (Rohwert)",
                                "value": 0
                            },
                            {
                                "caption": "String -> Ganzzahl",
                                "value": 1
                            },
                            {
                                "caption": "Datum/Zeit -> Unix-Timestamp",
                                "value": 2
                            }
                        ]
                    }
                },
                {
                    "caption": "Variablenprofil",
                    "name": "Profile",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Position",
                    "name": "Position",
                    "width": "90px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner"
                    }
                }
            ],
            "values": []
        },
        {
            "type": "ExpansionPanel",
            "caption": "3) Konfiguration importieren / exportieren (JSON)",
            "items": [
                {
                    "type": "ScriptEditor",
                    "name": "ExportBox",
                    "caption": "Export (zum Kopieren, z.B. als Backup oder zum Teilen)"
                },
                {
                    "type": "Button",
                    "caption": "Aktuelle Mapping-Liste hier ausgeben",
                    "onClick": "MQTTMAP_DoExport($id);"
                },
                {
                    "type": "ScriptEditor",
                    "name": "ImportBox",
                    "caption": "Import (JSON hier einfügen und übernehmen)"
                },
                {
                    "type": "Button",
                    "caption": "Eingefügtes JSON importieren (ersetzt aktuelles Mapping)",
                    "onClick": "MQTTMAP_DoImport($id, $ImportBox);",
                    "confirm": "Das aktuelle Mapping wird durch den importierten Inhalt ersetzt. Fortfahren?"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "4) Performance-Feintuning (optional)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Bei sehr vielen Topics (z.B. Victron: mehrere hundert) kann hier serverseitig vorgefiltert werden, welche Topics diese Instanz überhaupt zu sehen bekommt. Standard '.*' lässt alles durch, die eigentliche Zuordnung passiert danach anhand der Mapping-Liste oben."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "BaseFilter",
                    "caption": "ReceiveDataFilter (Regex)"
                }
            ]
        }
    ],
    "status": []
}
