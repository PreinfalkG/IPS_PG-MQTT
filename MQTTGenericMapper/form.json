{
    "elements": [
        {
            "type": "CheckBox",
            "name": "DebugMode",
            "caption": "Debug-Meldungen aktiv (sichtbar im Debug-Panel dieser Instanz)"
        },
        {
            "type": "ExpansionPanel",
            "caption": "1) Topics entdecken (optional, spart Tipparbeit)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Lernmodus einschalten, Änderungen übernehmen, ein paar Sekunden/Minuten warten (bis neue Topics einmal gesendet wurden), Formular neu öffnen. Danach unten gewünschte Topics auswählen und übernehmen."
                },
                {
                    "type": "CheckBox",
                    "name": "DiscoverMode",
                    "caption": "Lernmodus aktiv (alle Topics des Parents mitschneiden)"
                },
                {
                    "type": "List",
                    "name": "DiscoveredList",
                    "caption": "Erkannte Topics",
                    "rowCount": 10,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Übernehmen",
                            "name": "Selected",
                            "width": "100px",
                            "add": false,
                            "edit": {
                                "type": "CheckBox"
                            }
                        },
                        {
                            "caption": "Topic",
                            "name": "Topic",
                            "width": "850px"
                        },
                        {
                            "caption": "Letzter Payload",
                            "name": "Payload",
                            "width": "380px"
                        },
                        {
                            "caption": "Zuletzt gesehen",
                            "name": "LastSeen",
                            "width": "160px"
                        }
                    ],
                    "values": []
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Ausgewählte Topics übernehmen",
                            "onClick": "MQTTMAP_AddSelectedTopics($id, json_encode($DiscoveredList));"
                        },
                        {
                            "type": "Button",
                            "caption": "Alle erkannten Topics übernehmen",
                            "onClick": "MQTTMAP_AddAllDiscoveredTopics($id);"
                        },
                        {
                            "type": "Button",
                            "caption": "Liste erkannter Topics leeren",
                            "onClick": "MQTTMAP_ClearDiscovered($id);"
                        }
                    ]
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Parser-Parameter je nach gewähltem Parser (Feld bei 'Keine' und 'Zahl aus Text' leer lassen):"
        },
        {
            "type": "Label",
            "caption": "• Datum/Zeit: optionaler PHP-Formatstring, z.B. \"Y-m-d H:i:s\" oder \"d.m.Y H:i\" (leer = automatische Erkennung). Typ auf Integer stellen, Profil ~UnixTimestamp empfohlen."
        },
        {
            "type": "Label",
            "caption": "• Enum-Zuordnung: \"Label=Zahl\" Paare, per Komma oder Zeile getrennt, z.B. \"Offline=0,Online=1,undefined=-1\". Unbekannte Werte werden automatisch ergänzt. Typ auf Integer stellen."
        },
        {
            "type": "Label",
            "caption": "• JSON-Feld extrahieren: Punkt-Pfad in den JSON-Payload, z.B. \"battery.soc\" oder \"devices.0.voltage\"."
        },
        {
            "type": "Label",
            "caption": "• Skalierung: \"Faktor,Offset\", z.B. \"0.1,0\" wandelt einen Rohwert von 235 in 23.5 um. Typ auf Float stellen."
        },
        {
            "type": "Label",
            "caption": "• Dauer H:MM:SS.ffffff -> Sekunden: für Intervall-/Dauer-Strings wie \"0:05:06.932660\" (z.B. Python timedelta). Parser-Parameter bleibt leer. Typ auf Integer stellen."
        },
        {
            "type": "List",
            "name": "Mappings",
            "caption": "2) Topic → Variablen Mapping",
            "rowCount": 20,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Aktiv",
                    "name": "Active",
                    "width": "60px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "MQTT Topic",
                    "name": "Topic",
                    "width": "640px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Ident",
                    "name": "Ident",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Name",
                    "name": "Name",
                    "width": "200px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Typ",
                    "name": "VarType",
                    "width": "110px",
                    "add": 3,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Boolean",
                                "value": 0
                            },
                            {
                                "caption": "Integer",
                                "value": 1
                            },
                            {
                                "caption": "Float",
                                "value": 2
                            },
                            {
                                "caption": "String",
                                "value": 3
                            }
                        ]
                    }
                },
                {
                    "caption": "Parser",
                    "name": "Parser",
                    "width": "190px",
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Keine (Rohwert)",
                                "value": 0
                            },
                            {
                                "caption": "Zahl aus Text extrahieren",
                                "value": 1
                            },
                            {
                                "caption": "Datum/Zeit -> Unix-Timestamp",
                                "value": 2
                            },
                            {
                                "caption": "Enum-Zuordnung (Text -> Zahl)",
                                "value": 3
                            },
                            {
                                "caption": "JSON-Feld extrahieren",
                                "value": 4
                            },
                            {
                                "caption": "Skalierung (Faktor/Offset)",
                                "value": 5
                            },
                            {
                                "caption": "Millisekunden -> Sekunden",
                                "value": 6
                            },
                            {
                                "caption": "Dauer H:MM:SS.ffffff -> Sekunden",
                                "value": 7
                            }
                        ]
                    }
                },
                {
                    "caption": "Parser-Parameter",
                    "name": "ParserParam",
                    "width": "260px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Variablenprofil",
                    "name": "Profile",
                    "width": "160px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Position",
                    "name": "Position",
                    "width": "90px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner"
                    }
                }
            ],
            "values": []
        },
        {
            "type": "ExpansionPanel",
            "caption": "3) Konfiguration importieren / exportieren (JSON)",
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ColumnLayout",
                            "items": [
                                {
                                    "type": "ScriptEditor",
                                    "name": "ExportBox",
                                    "value": "[]",
                                    "width": "6400px",
                                    "rowCount": 18,
                                    "caption": "Export (zum Kopieren, z.B. als Backup oder zum Teilen)"
                                },
                                {
                                    "type": "Button",
                                    "caption": "Aktuelle Mapping-Liste hier ausgeben",
                                    "width": "600px",
                                    "onClick": "MQTTMAP_DoExport($id);"
                                },
                                {
                                     "type": "Label", 
                                     "caption": "",
                                     "width": "800px"
                                }
                            ]
                        },
                        {

                                     "type": "Label", 
                                     "caption": "",
                                     "width": "60px"

                        },
                        {
                            "type": "ColumnLayout",
                            "items": [
                                {
                                    "type": "ScriptEditor",
                                    "name": "ImportBox",
                                    "value": "[]",
                                    "width": "640px",
                                    "rowCount": 18,
                                    "caption": "Import (JSON hier einfügen und übernehmen)"
                                },
                                {
                                    "type": "Button",
                                    "caption": "Eingefügtes JSON importieren (ersetzt aktuelles Mapping)",
                                    "width": "600px",
                                    "onClick": "MQTTMAP_DoImport($id, $ImportBox);",
                                    "confirm": "Das aktuelle Mapping wird durch den importierten Inhalt ersetzt. Fortfahren?"
                                },
                                {
                                     "type": "Label", 
                                     "caption": "",
                                     "width": "800px"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "4) Performance-Feintuning (optional)",
            "items": [
                {
                    "type": "Label",
                    "caption": "Bei sehr vielen Topics (z.B. Victron) kann hier serverseitig vorgefiltert werden, welche Topics diese Instanz überhaupt zu sehen bekommt. Standard '.*' lässt alles durch, die eigentliche Zuordnung passiert danach anhand der Mapping-Liste oben."
                },
                {
                    "type": "ValidationTextBox",
                    "name": "BaseFilter",
                    "caption": "ReceiveDataFilter (Regex)"
                }
            ]
        }
    ],
    "status": []
}